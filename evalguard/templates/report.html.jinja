<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EvalGuard Report — {{ report.name }}</title>
<style>
  :root {
    --bg: #0f1115;
    --panel: #161922;
    --panel-2: #1c202b;
    --border: #262b38;
    --text: #e7e9ee;
    --muted: #9aa2b1;
    --accent: #6d8dff;
    --accent-2: #8f6dff;
    --good: #34d399;
    --good-bg: rgba(52, 211, 153, 0.12);
    --bad: #f87171;
    --bad-bg: rgba(248, 113, 113, 0.12);
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: radial-gradient(1200px 600px at 10% -10%, #1a1f2e 0%, var(--bg) 55%);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.5;
  }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 48px 24px 96px; }
  header.top { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 8px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 15px; letter-spacing: 0.02em; color: var(--muted); }
  .brand .dot { width: 8px; height: 8px; border-radius: 50%; background: linear-gradient(135deg, var(--accent), var(--accent-2)); box-shadow: 0 0 12px var(--accent); }
  h1 { font-size: 28px; margin: 4px 0 4px; }
  .meta { color: var(--muted); font-size: 13px; }
  .verdict {
    margin: 28px 0 32px;
    padding: 24px 28px;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: linear-gradient(135deg, var(--panel), var(--panel-2));
    display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;
  }
  .verdict.pass { border-color: rgba(52,211,153,0.35); }
  .verdict.fail { border-color: rgba(248,113,113,0.35); }
  .verdict-left { display: flex; align-items: center; gap: 20px; }
  .score-ring { width: 88px; height: 88px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 700; }
  .verdict.pass .score-ring { background: conic-gradient(var(--good) calc(var(--pct) * 1%), #263427 0); }
  .verdict.fail .score-ring { background: conic-gradient(var(--bad) calc(var(--pct) * 1%), #34252a 0); }
  .score-ring inner { }
  .score-ring-inner { width: 68px; height: 68px; border-radius: 50%; background: var(--panel); display: flex; align-items: center; justify-content: center; }
  .verdict-title { font-size: 17px; font-weight: 700; }
  .verdict.pass .verdict-title { color: var(--good); }
  .verdict.fail .verdict-title { color: var(--bad); }
  .verdict-sub { color: var(--muted); font-size: 13px; margin-top: 2px; }
  .badge { padding: 6px 12px; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; }
  .badge.pass { background: var(--good-bg); color: var(--good); }
  .badge.fail { background: var(--bad-bg); color: var(--bad); }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 36px; }
  .stat { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 16px 18px; }
  .stat .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; }
  .stat .value { font-size: 24px; font-weight: 700; margin-top: 6px; }
  .stat .value.good { color: var(--good); }
  .stat .value.bad { color: var(--bad); }
  section.cases h2 { font-size: 16px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 16px; }
  .case { border: 1px solid var(--border); background: var(--panel); border-radius: 14px; margin-bottom: 14px; overflow: hidden; }
  .case-head { display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; cursor: pointer; gap: 12px; }
  .case-head:hover { background: var(--panel-2); }
  .case-head-left { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .case-id { font-family: var(--mono); font-size: 13px; color: var(--muted); white-space: nowrap; }
  .case-desc { font-size: 14px; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .case-score { font-family: var(--mono); font-size: 13px; font-weight: 700; }
  .chev { color: var(--muted); font-size: 12px; transition: transform 0.15s ease; }
  .case.open .chev { transform: rotate(90deg); }
  .case-body { display: none; padding: 4px 18px 18px; border-top: 1px solid var(--border); }
  .case.open .case-body { display: block; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 14px; }
  @media (max-width: 720px) { .grid-2 { grid-template-columns: 1fr; } .stats { grid-template-columns: repeat(2, 1fr); } }
  .field-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 6px; }
  pre.code-block {
    background: #0b0d12; border: 1px solid var(--border); border-radius: 10px;
    padding: 12px 14px; font-family: var(--mono); font-size: 12.5px; white-space: pre-wrap;
    word-break: break-word; margin: 0; color: #d5d9e2; max-height: 260px; overflow: auto;
  }
  .evals { margin-top: 16px; }
  .eval-row { display: flex; align-items: flex-start; gap: 10px; padding: 8px 0; border-bottom: 1px dashed var(--border); font-size: 13px; }
  .eval-row:last-child { border-bottom: none; }
  .eval-icon { font-weight: 700; width: 18px; text-align: center; flex-shrink: 0; }
  .eval-icon.pass { color: var(--good); }
  .eval-icon.fail { color: var(--bad); }
  .eval-name { font-family: var(--mono); font-weight: 700; color: var(--text); flex-shrink: 0; }
  .eval-detail { color: var(--muted); }
  footer { margin-top: 48px; text-align: center; color: var(--muted); font-size: 12px; }
  footer a { color: var(--accent); text-decoration: none; }
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <div>
      <div class="brand"><span class="dot"></span> EVALGUARD REPORT</div>
      <h1>{{ report.name }}</h1>
      <div class="meta">Provider: {{ report.provider.type }} / {{ report.provider.model }} &middot; Generated {{ report.generated_at }} &middot; Duration {{ report.duration_seconds }}s</div>
    </div>
  </header>

  {% set pct = (report.overall_score * 100) | round(1) %}
  <div class="verdict {{ 'pass' if report.overall_passed else 'fail' }}" style="--pct: {{ pct }};">
    <div class="verdict-left">
      <div class="score-ring"><div class="score-ring-inner">{{ pct }}%</div></div>
      <div>
        <div class="verdict-title">{{ 'GATE PASSED' if report.overall_passed else 'GATE FAILED' }}</div>
        <div class="verdict-sub">Threshold: {{ (report.min_score * 100) | round(1) }}% &middot; Overall score: {{ pct }}%</div>
      </div>
    </div>
    <div class="badge {{ 'pass' if report.overall_passed else 'fail' }}">{{ 'PASS' if report.overall_passed else 'FAIL' }}</div>
  </div>

  <div class="stats">
    <div class="stat"><div class="label">Total Cases</div><div class="value">{{ report.total_cases }}</div></div>
    <div class="stat"><div class="label">Passed</div><div class="value good">{{ report.passed_cases }}</div></div>
    <div class="stat"><div class="label">Failed</div><div class="value bad">{{ report.failed_cases }}</div></div>
    <div class="stat"><div class="label">Overall Score</div><div class="value">{{ pct }}%</div></div>
  </div>

  <section class="cases">
    <h2>Case Results ({{ report.cases | length }})</h2>
    {% for case in report.cases %}
    <div class="case" id="case-{{ loop.index }}">
      <div class="case-head" onclick="document.getElementById('case-{{ loop.index }}').classList.toggle('open')">
        <div class="case-head-left">
          <span class="chev">&#9656;</span>
          <span class="case-id">{{ case.id }}</span>
          <span class="case-desc">{{ case.description or '' }}</span>
        </div>
        <div style="display:flex; align-items:center; gap:12px;">
          <span class="case-score" style="color: {{ 'var(--good)' if case.passed else 'var(--bad)' }};">{{ (case.score * 100) | round(1) }}%</span>
          <span class="badge {{ 'pass' if case.passed else 'fail' }}">{{ 'PASS' if case.passed else 'FAIL' }}</span>
        </div>
      </div>
      <div class="case-body">
        <div class="field-label">Rendered Prompt</div>
        <pre class="code-block">{{ case.prompt }}</pre>
        <div class="grid-2">
          <div>
            <div class="field-label">Expected</div>
            <pre class="code-block">{{ case.expected | tojson(indent=2) }}</pre>
          </div>
          <div>
            <div class="field-label">Actual Response</div>
            <pre class="code-block">{{ case.actual }}</pre>
          </div>
        </div>
        <div class="evals">
          <div class="field-label">Evaluations</div>
          {% for ev in case.evaluations %}
          <div class="eval-row">
            <span class="eval-icon {{ 'pass' if ev.passed else 'fail' }}">{{ '✓' if ev.passed else '✗' }}</span>
            <span class="eval-name">{{ ev.evaluator }}</span>
            <span class="eval-detail">score {{ (ev.score * 100) | round(1) }}% — {{ ev.detail }}</span>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endfor %}
  </section>

  <footer>
    Generated by <a href="https://github.com" target="_blank" rel="noopener">EvalGuard</a> — automated regression testing for LLM prompts.
  </footer>
</div>
</body>
</html>
